generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Catálogo local de espécies (CRUD da Entrega 1, agora persistido).
model Pokemon {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  types          String[]
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int      @map("special_attack")
  specialDefense Int      @map("special_defense")
  speed          Int
  imageUrl       String?  @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  /// GIN no array: atende o filtro por tipo (types @> ARRAY[...]).
  @@index([types], type: Gin, map: "pokemons_types_gin_idx")
  /// GIN com trigramas (extensão pg_trgm): atende a busca parcial por nome (ILIKE '%...%').
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "pokemons_name_trgm_idx")
  /// Ordenação padrão da listagem paginada.
  @@index([createdAt, id], map: "pokemons_created_at_id_idx")
  @@map("pokemons")
}

enum Role {
  TRAINER
  GYM_LEADER
  ADMIN
}

model Trainer {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  /// Hash bcrypt. Nulo apenas para treinadores criados antes da Entrega 3 (sem login).
  passwordHash  String?        @map("password_hash")
  role          Role           @default(TRAINER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  captures      Capture[]
  refreshTokens RefreshToken[]

  @@map("trainers")
}

/// Refresh tokens opacos. Só o hash SHA-256 é guardado: um vazamento do banco não
/// permite usar os tokens. Cada uso gera um novo token e revoga o anterior (rotação).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  trainerId String    @map("trainer_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  trainer   Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("refresh_tokens")
}

/// Pokémon capturado por um treinador, com os dados oficiais obtidos da PokéAPI.
model Capture {
  id             String   @id @default(uuid()) @db.Uuid
  trainerId      String   @map("trainer_id") @db.Uuid
  pokedexNumber  Int      @map("pokedex_number")
  name           String
  nickname       String?
  types          String[]
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int      @map("special_attack")
  specialDefense Int      @map("special_defense")
  speed          Int
  imageUrl       String?  @map("image_url")
  capturedAt     DateTime @default(now()) @map("captured_at")
  trainer        Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  /// Ranking de Pokémons mais capturados (GROUP BY pokedex_number).
  @@index([pokedexNumber], map: "captures_pokedex_number_idx")
  @@map("captures")
}

/// Cache das consultas à PokéAPI (lookupKey = termo buscado, normalizado em minúsculas).
model PokedexCacheEntry {
  lookupKey      String   @id @map("lookup_key")
  pokedexNumber  Int      @map("pokedex_number")
  name           String
  types          String[]
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int      @map("special_attack")
  specialDefense Int      @map("special_defense")
  speed          Int
  imageUrl       String?  @map("image_url")
  height         Float
  weight         Float
  cachedAt       DateTime @default(now()) @map("cached_at")

  @@map("pokedex_cache")
}
