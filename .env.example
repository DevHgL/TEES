NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://pokemanager:pokemanager@localhost:5432/pokemanager?schema=public"
POKEAPI_BASE_URL="https://pokeapi.co/api/v2"

# Validade do cache de consultas à PokéAPI (padrão: 168h = 7 dias)
POKEDEX_CACHE_TTL_HOURS=168
# Quantos Pokémons o seed importa da PokéAPI (padrão: 151 = 1ª geração)
SEED_POKEMON_LIMIT=151

# --- Autenticação (Entrega 3) ---
# Segredo de assinatura do JWT: mínimo de 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-48-bytes"
JWT_EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# --- Segurança HTTP ---
# Origens extras liberadas no CORS, separadas por vírgula (o frontend em / já é a mesma origem)
CORS_ORIGINS=""
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5

# --- Seed: contas de demonstração (só para desenvolvimento) ---
SEED_ADMIN_EMAIL="admin@pokemanager.dev"
SEED_DEMO_PASSWORD="pokemon123"
